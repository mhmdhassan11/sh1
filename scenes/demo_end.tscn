[gd_scene format=3 uid="uid://demoend1"]

[ext_resource type="Script" path="res://scripts/demo_end.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/game.webp" id="2"]
[ext_resource type="FontFile" path="res://fonts/GROBOLD.ttf" id="3"]
[ext_resource type="Texture2D" path="res://assets/zr-removebg-preview.webp" id="4"]

[sub_resource type="StyleBoxTexture" id="StyleBoxTexture_btn"]
texture = ExtResource("4")
texture_margin_left = 20.0
texture_margin_top = 10.0
texture_margin_right = 20.0
texture_margin_bottom = 20.0

[node name="DemoEnd" type="Control"]
layout_mode = 3
